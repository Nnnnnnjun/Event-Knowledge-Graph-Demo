# ============================================================
# Event-Knowledge-Graph-Demo / 本地环境变量示例
# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# ============================================================

# DeepSeek 开放平台 API Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
# Neo4j 连接信息
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# 是否清空数据库后重建（默认 false，避免误删）
# 第一次跑 Demo 时可设为 true
RESET_DB=false

# COVID Notebook：是否只保留通过时间校验的 FOLLOWED_BY
# false = 保留 OpenKG 原标注（194 条，其中 2 条时间倒置）
# true  = 只写入严格时序边（192 条）
STRICT_TIME_ORDER=false
